# Modelo das variáveis de ambiente do GoToUSA.
# Copie para ".env" e preencha. O arquivo ".env" NUNCA vai para o Git.
#
# O modo sem conta (tudo no navegador) não precisa de nenhuma variável.
# As variáveis abaixo são do backend local (docs/backend-local.md).

# --- Banco de dados (PostgreSQL pelo Docker, só em 127.0.0.1) ---
POSTGRES_USER=gotousa
# Use uma senha longa e aleatória.
POSTGRES_PASSWORD=
POSTGRES_DB=gotousa

# --- API (NestJS, só em 127.0.0.1) ---
# Endereço do banco para a API: repita aqui a mesma senha do POSTGRES_PASSWORD.
DATABASE_URL=postgresql://gotousa:<senha>@127.0.0.1:5432/gotousa
# A API só aceita escutar no próprio PC (127.0.0.1, ::1 ou localhost).
API_HOST=127.0.0.1
API_PORT=4000
# Opcional, para o app (Next.js): para onde repassar o /api/*. Padrão: http://127.0.0.1:4000
# Lido no "pnpm build" do app; se mudar, gere o app de novo.
# API_INTERNAL_URL=http://127.0.0.1:4000
