# Modelo das variáveis de ambiente do GoToUSA.
# Copie para ".env" e preencha. O arquivo ".env" NUNCA vai para o Git.
#
# O modo sem conta (tudo no navegador) não precisa de nenhuma variável.
# As variáveis abaixo são do backend local (docs/backend-local.md).

# --- Banco de dados (PostgreSQL pelo Docker, só em 127.0.0.1) ---
POSTGRES_USER=gotousa
# Use uma senha longa e aleatória.
POSTGRES_PASSWORD=
POSTGRES_DB=gotousa

# --- API (NestJS, só em 127.0.0.1) ---
# Endereço do banco para a API: repita aqui a mesma senha do POSTGRES_PASSWORD.
DATABASE_URL=postgresql://gotousa:<senha>@127.0.0.1:5432/gotousa
# A API só aceita escutar no próprio PC (127.0.0.1, ::1 ou localhost).
API_HOST=127.0.0.1
API_PORT=4000

# --- Contas (Better Auth) ---
# 32+ caracteres aleatórios. Trocar o segredo derruba todas as sessões.
BETTER_AUTH_SECRET=
# Endereço do app na rede de casa (links dos e-mails e origem aceita). IP do PC reservado no roteador.
BETTER_AUTH_URL=http://192.168.0.6:3000
# Quem pode criar conta sem convite (e-mails separados por vírgula).
AUTH_SIGNUP_ALLOWLIST=

# --- E-mail (Mailpit no passo 3: tela em http://localhost:8025; Gmail no passo 4) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GoToUSA <nao-responda@gotousa.local>

# --- App (Next.js), lidos no "pnpm build"; se mudar, gere o app de novo ---
# Mostra a seção Conta. Deixe "false" (ou apague) na versão sem backend.
ACCOUNTS_ENABLED=true
# Para onde repassar o /api/*. Padrão: http://127.0.0.1:4000
# API_INTERNAL_URL=http://127.0.0.1:4000
