{
  "name": "gotousa",
  "private": true,
  "description": "GoToUSA: companheiro de jornada para quem quer morar nos Estados Unidos.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @gotousa/web dev",
    "build": "pnpm --filter @gotousa/web build",
    "start": "pnpm --filter @gotousa/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "data:cities": "node scripts/build-us-cities.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "api:dev": "pnpm --filter @gotousa/api dev",
    "api:build": "pnpm --filter @gotousa/api build",
    "api:start": "pnpm --filter @gotousa/api start",
    "db:migrate": "pnpm --filter @gotousa/api migrate",
    "db:migrate:new": "pnpm --filter @gotousa/api migrate:new"
  }
}
